# Shared source settings for restream -> FFmpeg -> MediaMTX.
# No player/player-args: every viewer chooses its own player.
http-proxy=socks5h://127.0.0.1:7891
http-ignore-env
# No added rewind by default. YouTube/Twitch load config-rtsp-delayed after this.
hls-start-offset=0
retry-streams=5
retry-max=60
retry-open=5
stream-segment-attempts=60
stream-segment-timeout=5
hls-playlist-reload-time=5
hls-playlist-reload-attempts=60
stream-timeout=300
stream-segmented-queue-deadline=0
http-timeout=10
# Buffer capacity only; this does not impose a startup delay.
# Holds downloads ahead of FFmpeg's 1x consumption.
ringbuffer-size=128M
