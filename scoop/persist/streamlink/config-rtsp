# Shared source settings for restream -> FFmpeg -> MediaMTX.
# No player/player-args: every viewer chooses its own player.
# Show status, warnings, and failure reasons without per-segment diagnostics.
loglevel=info
http-proxy=socks5h://127.0.0.1:7891
http-ignore-env
# The publisher supplies the startup hold; do not stack an extra HLS rewind.
hls-start-offset=0
retry-streams=5
retry-max=60
retry-open=5
stream-segment-attempts=60
stream-segment-timeout=5
hls-playlist-reload-time=5
hls-playlist-reload-attempts=60
stream-timeout=300
stream-segmented-queue-deadline=0
http-timeout=10
# Streamlink owns the shared reserve for all viewers. The publisher waits
# before reading, then FFmpeg consumes at 1x. Capacity is a limit, not a target.
ringbuffer-size=128M
